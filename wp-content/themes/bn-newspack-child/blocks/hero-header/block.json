{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "bn/hero-header",
  "title": "BN Hero Post",
  "category": "design",
  "icon": "cover-image",
  "description": "Full-width hero with post featured image, title, excerpt, and author",
  "keywords": ["hero", "header", "featured"],
  "supports": {
    "align": ["full"],
    "anchor": true,
    "html": false
  },
  "attributes": {
    "postId": {
      "type": "number",
      "default": 0
    },
    "contentPosition": {
      "type": "string",
      "enum": ["left", "center", "right"],
      "default": "center"
    },
    "mobileHeight": {
      "type": "string",
      "default": "60vh"
    },
    "desktopHeight": {
      "type": "string",
      "default": "80vh"
    },
    "showCategory": {
      "type": "boolean",
      "default": true
    },
    "showDate": {
      "type": "boolean",
      "default": true
    },
    "showExcerpt": {
      "type": "boolean",
      "default": true
    },
    "showAuthor": {
      "type": "boolean",
      "default": true
    },
    "showAvatar": {
      "type": "boolean",
      "default": true
    },
    "overlay": {
      "type": "string",
      "default": "linear-gradient(180deg, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0.1) 100%)"
    },
    "taxonomy": {
      "type": "string",
      "default": "category"
    },
    "featuredImagePosition": {
      "type": "string",
      "enum": ["behind", "beside"],
      "default": "behind"
    },
    "besideBackgroundColor": {
      "type": "string",
      "default": ""
    },
    "imageAlignment": {
      "type": "string",
      "enum": ["left", "right"],
      "default": "right"
    },
    "typographyScale": {
      "type": "number",
      "default": 1
    },
    "titleFontSize": {
      "type": "string",
      "default": ""
    },
    "titleColor": {
      "type": "string",
      "default": ""
    },
    "titleBackgroundColor": {
      "type": "string",
      "default": ""
    },
    "categoryFontSize": {
      "type": "string",
      "default": ""
    },
    "categoryColor": {
      "type": "string",
      "default": ""
    },
    "categoryBackgroundColor": {
      "type": "string",
      "default": ""
    },
    "subheadingFontSize": {
      "type": "string",
      "default": ""
    },
    "subheadingColor": {
      "type": "string",
      "default": ""
    },
    "subheadingBackgroundColor": {
      "type": "string",
      "default": ""
    },
    "authorFontSize": {
      "type": "string",
      "default": ""
    },
    "authorColor": {
      "type": "string",
      "default": ""
    },
    "authorBackgroundColor": {
      "type": "string",
      "default": ""
    },
    "dateFontSize": {
      "type": "string",
      "default": ""
    },
    "dateColor": {
      "type": "string",
      "default": ""
    },
    "dateBackgroundColor": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "bn-newspack-child",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css",
  "render": "file:./render.php"
}
